{
  "name": "communi-con",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "pnpm check && vite build",
    "dev": "vite dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "partyserver": "0.5.10",
    "partysocket": "1.3.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.60.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.140.0"
  }
}
