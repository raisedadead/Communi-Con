{
  "name": "communi-con",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "build": "npm run check && vite build",
    "preview": "X_LOCAL_EXPLORER=false X_LOCAL_OBSERVABILITY=false wrangler dev --ip 127.0.0.1 --port 8000 --local",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "partyserver": "0.5.10",
    "partysocket": "1.3.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.136.3"
  }
}
